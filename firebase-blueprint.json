{
  "entities": {
    "CatalogVariety": {
      "title": "BSBlooms Catalog Variety",
      "description": "A BSBlooms greenhouse flower variety displayed on the vertical swipe showcase.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Document identifier for the flower variety",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "orderIndex": {
          "type": "number",
          "description": "Display order on the vertical swipe showcase"
        },
        "nameEn": {
          "type": "string",
          "description": "Variety name",
          "minLength": 1,
          "maxLength": 100
        },
        "color": {
          "type": "string",
          "description": "Flower petal color label",
          "minLength": 0,
          "maxLength": 60
        },
        "cropEn": {
          "type": "string",
          "description": "Crop name (e.g., Gerbera)",
          "minLength": 0,
          "maxLength": 60
        },
        "typeEn": {
          "type": "string",
          "description": "Flower type (e.g., Standard · Semi-double)",
          "minLength": 0,
          "maxLength": 60
        },
        "breederCode": {
          "type": "string",
          "description": "Breeder code or VBN catalog code",
          "minLength": 0,
          "maxLength": 60
        },
        "stemLength": {
          "type": "string",
          "description": "Stem length specification (e.g., 60 cm)",
          "minLength": 0,
          "maxLength": 60
        },
        "extraSpecEn": {
          "type": "string",
          "description": "Additional cultivar traits (diameter, vase life, center)",
          "minLength": 0,
          "maxLength": 240
        },
        "availability": {
          "type": "string",
          "description": "Current stock status",
          "enum": ["in_stock", "limited", "out_of_stock"]
        },
        "photos": {
          "type": "array",
          "description": "List of 1 to 5 photo URLs or compressed data URIs"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp at creation"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest update"
        }
      },
      "required": [
        "id",
        "orderIndex",
        "nameEn",
        "color",
        "cropEn",
        "typeEn",
        "breederCode",
        "stemLength",
        "extraSpecEn",
        "availability",
        "photos",
        "createdAt",
        "updatedAt"
      ]
    },
    "CatalogMeta": {
      "title": "BSBlooms Store Settings",
      "description": "Publicly readable BSBlooms merchant contact information and catalog initialization flag.",
      "type": "object",
      "properties": {
        "shopNameEn": {
          "type": "string",
          "description": "Brand name",
          "minLength": 1,
          "maxLength": 80
        },
        "phone": {
          "type": "string",
          "description": "Merchant phone number for Call Now",
          "minLength": 6,
          "maxLength": 20,
          "pattern": "^\\+?[0-9\\- ]{6,20}$"
        },
        "whatsapp": {
          "type": "string",
          "description": "Merchant WhatsApp digits with country code",
          "minLength": 8,
          "maxLength": 18,
          "pattern": "^[0-9]{8,18}$"
        },
        "locationEn": {
          "type": "string",
          "description": "Dispatch or location label",
          "minLength": 0,
          "maxLength": 120
        },
        "hoursEn": {
          "type": "string",
          "description": "Business hours label",
          "minLength": 0,
          "maxLength": 80
        },
        "catalogInitialized": {
          "type": "boolean",
          "description": "Whether initial catalog varieties have been seeded to Firestore"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest update"
        }
      },
      "required": [
        "shopNameEn",
        "phone",
        "whatsapp",
        "locationEn",
        "hoursEn",
        "catalogInitialized",
        "updatedAt"
      ]
    },
    "AdminAuthConfig": {
      "title": "Admin Password Config",
      "description": "Private non-readable document holding the double-SHA-256 hash of the merchant admin password.",
      "type": "object",
      "properties": {
        "passwordDoubleHash": {
          "type": "string",
          "description": "Lowercase 64-char hex SHA-256 hash of the admin proof",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest password update"
        }
      },
      "required": ["passwordDoubleHash", "updatedAt"]
    },
    "AdminAuthGate": {
      "title": "Admin Auth Gate",
      "description": "Private write-only document verified atomically via getAfter in merchant write batches.",
      "type": "object",
      "properties": {
        "proof": {
          "type": "string",
          "description": "Lowercase 64-char hex salted SHA-256 password proof",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp matching the atomic batch request.time"
        }
      },
      "required": ["proof", "updatedAt"]
    },
    "Flower": {
      "title": "Legacy Flower Variety",
      "description": "Legacy flower variety schema preserved for backward compatibility.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "orderIndex": { "type": "number" },
        "nameEn": { "type": "string", "minLength": 1, "maxLength": 100 },
        "nameHi": { "type": "string", "minLength": 1, "maxLength": 120 },
        "cropEn": { "type": "string", "minLength": 0, "maxLength": 60 },
        "cropHi": { "type": "string", "minLength": 0, "maxLength": 80 },
        "typeEn": { "type": "string", "minLength": 0, "maxLength": 60 },
        "typeHi": { "type": "string", "minLength": 0, "maxLength": 80 },
        "breederCode": { "type": "string", "minLength": 0, "maxLength": 60 },
        "stemLength": { "type": "string", "minLength": 0, "maxLength": 60 },
        "extraSpecEn": { "type": "string", "minLength": 0, "maxLength": 240 },
        "extraSpecHi": { "type": "string", "minLength": 0, "maxLength": 280 },
        "availability": { "type": "string", "enum": ["in_stock", "limited", "out_of_stock"] },
        "price": { "type": "number" },
        "unitEn": { "type": "string", "minLength": 0, "maxLength": 40 },
        "unitHi": { "type": "string", "minLength": 0, "maxLength": 50 },
        "photos": { "type": "array" },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "orderIndex", "nameEn", "nameHi", "cropEn", "cropHi",
        "typeEn", "typeHi", "breederCode", "stemLength", "extraSpecEn", "extraSpecHi",
        "availability", "unitEn", "unitHi", "photos", "createdBy", "createdAt", "updatedAt"
      ]
    },
    "StoreSettings": {
      "title": "Legacy Store Settings",
      "description": "Legacy store settings schema preserved for backward compatibility.",
      "type": "object",
      "properties": {
        "shopNameEn": { "type": "string", "minLength": 1, "maxLength": 80 },
        "shopNameHi": { "type": "string", "minLength": 1, "maxLength": 100 },
        "phone": { "type": "string", "minLength": 6, "maxLength": 20, "pattern": "^\\+?[0-9\\- ]{6,20}$" },
        "whatsapp": { "type": "string", "minLength": 8, "maxLength": 18, "pattern": "^[0-9]{8,18}$" },
        "locationEn": { "type": "string", "minLength": 0, "maxLength": 120 },
        "locationHi": { "type": "string", "minLength": 0, "maxLength": 150 },
        "hoursEn": { "type": "string", "minLength": 0, "maxLength": 80 },
        "hoursHi": { "type": "string", "minLength": 0, "maxLength": 100 },
        "updatedBy": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "shopNameEn", "shopNameHi", "phone", "whatsapp",
        "locationEn", "locationHi", "hoursEn", "hoursHi", "updatedBy", "updatedAt"
      ]
    },
    "AdminUser": {
      "title": "Admin User",
      "description": "Authorized BS Blooms merchant administrator.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email", "minLength": 3, "maxLength": 150 },
        "role": { "type": "string", "enum": ["admin"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role", "createdAt"]
    }
  },
  "firestore": {
    "/catalogVarieties/{flowerId}": {
      "schema": { "$ref": "#/entities/CatalogVariety" },
      "description": "Public BSBlooms Gerbera showcase varieties ordered by orderIndex."
    },
    "/catalogMeta/{metaId}": {
      "schema": { "$ref": "#/entities/CatalogMeta" },
      "description": "Public BSBlooms contact settings document (/catalogMeta/store)."
    },
    "/adminAuth/config": {
      "schema": { "$ref": "#/entities/AdminAuthConfig" },
      "description": "Non-readable merchant password double-hash configuration."
    },
    "/adminAuth/gate": {
      "schema": { "$ref": "#/entities/AdminAuthGate" },
      "description": "Non-readable atomic batch proof verification gate."
    },
    "/flowers/{flowerId}": {
      "schema": { "$ref": "#/entities/Flower" },
      "description": "Legacy flower collection."
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/StoreSettings" },
      "description": "Legacy settings collection."
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Authorized merchant administrator accounts."
    }
  }
}
